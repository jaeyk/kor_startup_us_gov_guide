rules_version = '2';

// Readers signed in with Google can add feedback as themselves. Only admins
// can read or delete it; nobody can edit it. A user is an admin when the
// document `admins/{their uid}` exists, which only the Firebase console can
// create. Field names must match `submitFeedback` in `src/firebase.ts`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /feedback/{id} {
      allow create: if isGoogleUser() && isValidFeedback(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /admins/{uid} {
      // Each user may check only whether they themselves are an admin.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isValidFeedback(data) {
      return data.keys().hasOnly([
          'chapterNumber', 'chapterTitle', 'quote', 'wantToKnow', 'why',
          'uid', 'email', 'name', 'page', 'createdAt'
        ])
        && data.keys().hasAll([
          'chapterNumber', 'chapterTitle', 'quote', 'wantToKnow', 'why',
          'uid', 'email', 'name', 'page', 'createdAt'
        ])
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.createdAt == request.time
        && data.chapterNumber is int
        && data.chapterNumber >= 0 && data.chapterNumber <= 50
        && isText(data.chapterTitle, 0, 200)
        && isText(data.quote, 0, 600)
        && isText(data.wantToKnow, 1, 5000)
        && isText(data.why, 0, 5000)
        && isText(data.name, 0, 200)
        && isText(data.page, 0, 500);
    }
  }
}
